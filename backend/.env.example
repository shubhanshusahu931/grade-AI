# Copy this file to .env and fill in real values. Never commit the real .env.

APP_NAME=Industry Grade AI
ENV=development
DEBUG=true

# For Docker use: docker-compose overrides this automatically to point at
# the "db" service. For a local (non-Docker) Postgres instance, point this
# at wherever your own Postgres+pgvector server is running.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ind_grade_ai

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

GEMINI_API_KEY=your_real_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_GENERATION_MODEL=models/gemini-3.8-flash
EMBEDDING_DIM=768

PLATFORM_FETCH_TIMEOUT_SECONDS=12.0

CORS_ALLOW_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:8000","http://127.0.0.1:8000"]
